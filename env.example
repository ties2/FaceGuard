# ==========================================
# Database (PostgreSQL in Docker; DATABASE_URL overrides for local/CI)
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ml_serving_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL=sqlite:///./faceguard.db

# ==========================================
# Application
# ==========================================
APP_ENV=development
ARTIFACT_STORAGE_BACKEND=local
LOCAL_ARTIFACT_DIR=/app/model_artifacts/

# ==========================================
# FaceGuard
# ==========================================
FACEGUARD_SESSION_SECRET=change-me-32-bytes-of-randomness
FACEGUARD_POLICY_PATH=configs/policy.yaml
# simulated | facetec
FACEGUARD_VENDOR=simulated
# FACETEC_SERVER_URL=https://facetec-server.internal:8080
# FACETEC_DEVICE_KEY=...

# ==========================================
# Monitoring (Grafana)
# ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
